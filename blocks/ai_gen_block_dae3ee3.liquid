{% doc %}
  @prompt
    An interactive before/after image slider. It should show 2 images overlapped that can be compared by dragging the slider.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-before-after-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    user-select: none;
    touch-action: pan-y;
  }

  .ai-before-after-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-before-after-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
  }

  .ai-before-after-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-before-after-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-before-after-before-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(0 var(--ai-clip-right-{{ ai_gen_id }}) 0 0);
  }

  .ai-before-after-before-image-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .ai-before-after-slider-handle-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: var(--ai-slider-position-{{ ai_gen_id }});
    width: {{ block.settings.handle_width }}px;
    height: 100%;
    transform: translateX(-50%);
    cursor: ew-resize;
    z-index: 10;
  }

  .ai-before-after-slider-line-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: {{ block.settings.line_width }}px;
    height: 100%;
    background-color: {{ block.settings.line_color }};
  }

  .ai-before-after-slider-button-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.handle_size }}px;
    height: {{ block.settings.handle_size }}px;
    background-color: {{ block.settings.handle_color }};
    border: {{ block.settings.handle_border_width }}px solid {{ block.settings.handle_border_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .ai-before-after-slider-arrows-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.arrow_color }};
  }

  .ai-before-after-slider-arrows-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.handle_size }}px * 0.3);
    height: calc({{ block.settings.handle_size }}px * 0.3);
  }

  .ai-before-after-label-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.label_position_vertical }}%;
    padding: 8px 16px;
    background-color: {{ block.settings.label_bg_color }};
    color: {{ block.settings.label_text_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    border-radius: 4px;
    pointer-events: none;
    z-index: 5;
  }

  .ai-before-after-label-before-{{ ai_gen_id }} {
    left: {{ block.settings.label_position_horizontal }}%;
  }

  .ai-before-after-label-after-{{ ai_gen_id }} {
    right: {{ block.settings.label_position_horizontal }}%;
  }

  @media screen and (max-width: 749px) {
    .ai-before-after-slider-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<before-after-slider-{{ ai_gen_id }}
  class="ai-before-after-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-initial-position="{{ block.settings.initial_position }}"
>
  <div class="ai-before-after-container-{{ ai_gen_id }}">
    <div class="ai-before-after-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.after_image %}
        <img
          src="{{ block.settings.after_image | image_url: width: 2000 }}"
          alt="{{ block.settings.after_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.after_image.width }}"
          height="{{ block.settings.after_image.height }}"
          class="ai-before-after-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-before-after-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-before-after-empty-state-{{ ai_gen_id }}">
            Next, add an after image
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.before_image %}
      <div
        class="ai-before-after-before-image-{{ ai_gen_id }}"
        style="--ai-clip-right-{{ ai_gen_id }}: {{ 100 | minus: block.settings.initial_position }}%;"
      >
        <img
          src="{{ block.settings.before_image | image_url: width: 2000 }}"
          alt="{{ block.settings.before_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.before_image.width }}"
          height="{{ block.settings.before_image.height }}"
        >
      </div>
    {% endif %}

    <div
      class="ai-before-after-slider-handle-{{ ai_gen_id }}"
      style="--ai-slider-position-{{ ai_gen_id }}: {{ block.settings.initial_position }}%;"
    >
      <div class="ai-before-after-slider-line-{{ ai_gen_id }}"></div>
      <div class="ai-before-after-slider-button-{{ ai_gen_id }}">
        <div class="ai-before-after-slider-arrows-{{ ai_gen_id }}">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </div>
    </div>

    {% if block.settings.show_labels %}
      {% if block.settings.before_label != blank %}
        <div class="ai-before-after-label-{{ ai_gen_id }} ai-before-after-label-before-{{ ai_gen_id }}">
          {{ block.settings.before_label }}
        </div>
      {% endif %}
      {% if block.settings.after_label != blank %}
        <div class="ai-before-after-label-{{ ai_gen_id }} ai-before-after-label-after-{{ ai_gen_id }}">
          {{ block.settings.after_label }}
        </div>
      {% endif %}
    {% endif %}
  </div>
</before-after-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BeforeAfterSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.isDragging = false;
        this.container = null;
        this.handle = null;
        this.beforeImage = null;
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-before-after-container-{{ ai_gen_id }}');
        this.handle = this.querySelector('.ai-before-after-slider-handle-{{ ai_gen_id }}');
        this.beforeImage = this.querySelector('.ai-before-after-before-image-{{ ai_gen_id }}');

        if (!this.container || !this.handle) return;

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.handle.addEventListener('mousedown', this.startDrag.bind(this));
        this.handle.addEventListener('touchstart', this.startDrag.bind(this), { passive: true });

        document.addEventListener('mousemove', this.onDrag.bind(this));
        document.addEventListener('touchmove', this.onDrag.bind(this), { passive: false });

        document.addEventListener('mouseup', this.stopDrag.bind(this));
        document.addEventListener('touchend', this.stopDrag.bind(this));

        this.container.addEventListener('click', this.onContainerClick.bind(this));
      }

      startDrag(e) {
        this.isDragging = true;
        e.preventDefault();
      }

      stopDrag() {
        this.isDragging = false;
      }

      onDrag(e) {
        if (!this.isDragging) return;

        e.preventDefault();
        this.updatePosition(e);
      }

      onContainerClick(e) {
        if (e.target.closest('.ai-before-after-slider-handle-{{ ai_gen_id }}')) return;
        this.updatePosition(e);
      }

      updatePosition(e) {
        const rect = this.container.getBoundingClientRect();
        const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        let x = clientX - rect.left;

        x = Math.max(0, Math.min(x, rect.width));

        const percentage = (x / rect.width) * 100;

        this.handle.style.setProperty('--ai-slider-position-{{ ai_gen_id }}', percentage + '%');

        if (this.beforeImage) {
          this.beforeImage.style.setProperty('--ai-clip-right-{{ ai_gen_id }}', (100 - percentage) + '%');
        }
      }
    }

    customElements.define('before-after-slider-{{ ai_gen_id }}', BeforeAfterSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Before/after slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "range",
      "id": "initial_position",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Initial slider position",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "Show labels",
      "default": true
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "range",
      "id": "label_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Label font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "label_position_vertical",
      "min": 5,
      "max": 95,
      "step": 5,
      "unit": "%",
      "label": "Label vertical position",
      "default": 10
    },
    {
      "type": "range",
      "id": "label_position_horizontal",
      "min": 5,
      "max": 20,
      "step": 5,
      "unit": "%",
      "label": "Label horizontal position",
      "default": 5
    },
    {
      "type": "color",
      "id": "label_bg_color",
      "label": "Label background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Slider handle"
    },
    {
      "type": "range",
      "id": "handle_size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Handle size",
      "default": 50
    },
    {
      "type": "color",
      "id": "handle_color",
      "label": "Handle background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "handle_border_width",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Handle border width",
      "default": 2
    },
    {
      "type": "color",
      "id": "handle_border_color",
      "label": "Handle border",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "handle_width",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Handle width",
      "default": 50
    },
    {
      "type": "range",
      "id": "line_width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Line width",
      "default": 2
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Line color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Before/after slider"
    }
  ]
}
{% endschema %}
