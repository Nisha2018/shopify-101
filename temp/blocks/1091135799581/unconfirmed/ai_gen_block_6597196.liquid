{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 32px 24px;
    box-sizing: border-box;
  }

  .ai-timeline-{{ ai_gen_id }}__inner { max-width: 760px; margin: 0 auto; }
  .ai-timeline-{{ ai_gen_id }}__heading { margin: 0 0 28px; font-size: clamp(24px, 4vw, 36px); line-height: 1.2; }
  .ai-timeline-{{ ai_gen_id }}__list { position: relative; display: grid; gap: 0; }
  .ai-timeline-{{ ai_gen_id }}__list::before,
  .ai-timeline-{{ ai_gen_id }}__progress { position: absolute; left: 17px; top: 18px; width: 2px; height: calc(100% - 36px); }
  .ai-timeline-{{ ai_gen_id }}__list::before { content: ''; background: {{ block.settings.track_color }}; }
  .ai-timeline-{{ ai_gen_id }}__progress { height: 0; background: {{ block.settings.accent_color }}; z-index: 1; transition: height 180ms ease-out; }
  .ai-timeline-{{ ai_gen_id }}__item { position: relative; z-index: 2; display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 20px; padding: 0 0 34px; }
  .ai-timeline-{{ ai_gen_id }}__item:last-child { padding-bottom: 0; }
  .ai-timeline-{{ ai_gen_id }}__marker { width: 36px; height: 36px; box-sizing: border-box; border: 2px solid {{ block.settings.track_color }}; border-radius: 50%; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; cursor: pointer; }
  .ai-timeline-{{ ai_gen_id }}__item.is-active .ai-timeline-{{ ai_gen_id }}__marker,
  .ai-timeline-{{ ai_gen_id }}__marker:focus-visible { border-color: {{ block.settings.accent_color }}; background: {{ block.settings.accent_color }}; color: {{ block.settings.marker_text_color }}; }
  .ai-timeline-{{ ai_gen_id }}__marker:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 3px; }
  .ai-timeline-{{ ai_gen_id }}__content { padding-top: 4px; }
  .ai-timeline-{{ ai_gen_id }}__title { margin: 0 0 8px; font-size: 20px; line-height: 1.3; }
  .ai-timeline-{{ ai_gen_id }}__body { line-height: 1.6; }
  .ai-timeline-{{ ai_gen_id }}__body p { margin: 0; }
  @media (max-width: 749px) {
    .ai-timeline-{{ ai_gen_id }} { padding: 24px 16px; }
    .ai-timeline-{{ ai_gen_id }}__item { gap: 14px; padding-bottom: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-timeline-{{ ai_gen_id }}__progress { transition: none; }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-timeline-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-timeline-{{ ai_gen_id }}__list" aria-label="{{ block.settings.heading | default: 'Timeline' | escape }}">
      <span class="ai-timeline-{{ ai_gen_id }}__progress" aria-hidden="true"></span>
      {% for i in (1..4) %}
        {% assign title_key = 'step_' | append: i | append: '_title' %}
        {% assign body_key = 'step_' | append: i | append: '_body' %}
        {% assign step_title = block.settings[title_key] %}
        {% assign step_body = block.settings[body_key] %}
        {% if step_title != blank or step_body != blank %}
          <article class="ai-timeline-{{ ai_gen_id }}__item{% if forloop.first %} is-active{% endif %}" data-timeline-item>
            <button class="ai-timeline-{{ ai_gen_id }}__marker" type="button" aria-label="Go to step {{ i }}: {{ step_title | escape }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-timeline-marker>{{ i }}</button>
            <div class="ai-timeline-{{ ai_gen_id }}__content" data-timeline-content>
              {% if step_title != blank %}<h3 class="ai-timeline-{{ ai_gen_id }}__title">{{ step_title | escape }}</h3>{% endif %}
              {% if step_body != blank %}<div class="ai-timeline-{{ ai_gen_id }}__body">{{ step_body }}</div>{% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'scroll-timeline-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class ScrollTimeline extends HTMLElement {
      connectedCallback() {
        this.items = Array.from(this.querySelectorAll('[data-timeline-item]'));
        this.progress = this.querySelector('.ai-timeline-{{ ai_gen_id }}__progress');
        this.items.forEach((item) => {
          const marker = item.querySelector('[data-timeline-marker]');
          marker.addEventListener('click', () => {
            item.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
            this.setActive(item);
          });
        });
        if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver((entries) => {
            const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => Math.abs(a.boundingClientRect.top - window.innerHeight * 0.45) - Math.abs(b.boundingClientRect.top - window.innerHeight * 0.45));
            if (visible.length) this.setActive(visible[0].target);
          }, { rootMargin: '-35% 0px -45% 0px', threshold: 0 });
          this.items.forEach((item) => this.observer.observe(item));
        }
        this.setActive(this.items[0]);
      }
      disconnectedCallback() { if (this.observer) this.observer.disconnect(); }
      setActive(activeItem) {
        if (!activeItem) return;
        this.items.forEach((item) => {
          const active = item === activeItem;
          item.classList.toggle('is-active', active);
          item.querySelector('[data-timeline-marker]').setAttribute('aria-pressed', String(active));
        });
        const list = this.querySelector('.ai-timeline-{{ ai_gen_id }}__list');
        const listRect = list.getBoundingClientRect();
        const markerRect = activeItem.querySelector('[data-timeline-marker]').getBoundingClientRect();
        this.progress.style.height = Math.max(0, markerRect.top + markerRect.height / 2 - listRect.top - 18) + 'px';
      }
    }
    customElements.define(tagName, ScrollTimeline);
  })();
</script>

{% schema %}
{
  "name": "Scroll timeline",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our journey" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#121212" },
    { "type": "color", "id": "accent_color", "label": "Highlight", "default": "#334FB4" },
    { "type": "color", "id": "marker_text_color", "label": "Highlight text", "default": "#FFFFFF" },
    { "type": "color", "id": "track_color", "label": "Timeline track", "default": "#767676" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#121212" },
    { "type": "header", "content": "Timeline steps" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "First milestone" },
    { "type": "richtext", "id": "step_1_body", "label": "Step 1 description", "default": "<p>Add details about this milestone.</p>" },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "Second milestone" },
    { "type": "richtext", "id": "step_2_body", "label": "Step 2 description", "default": "<p>Share what happened next.</p>" },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Third milestone" },
    { "type": "richtext", "id": "step_3_body", "label": "Step 3 description", "default": "<p>Describe another important moment.</p>" },
    { "type": "text", "id": "step_4_title", "label": "Step 4 title", "default": "Today" },
    { "type": "richtext", "id": "step_4_body", "label": "Step 4 description", "default": "<p>Finish with where the journey is now.</p>" }
  ],
  "presets": [{ "name": "Scroll timeline" }],
  "tag": null,
  "class": "scroll-timeline-block"
}
{% endschema %}