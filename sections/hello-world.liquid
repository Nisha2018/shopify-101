{%- for block in section.blocks -%}
  <h3>{{ block.type }}</h3>
{%- endfor -%}

{% schema %}
{
  "name": "Hello World",
  "settings": [],
  "blocks": [
    {
      "type": "title",
      "name": "title",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hello World"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#e9e9e9"
        },
        {
          "type": "color",
          "id": "font_color",
          "label": "Font Color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hello World"
    }
  ]
}
{% endschema %}
