<div class="fbt-container">
    <h2>{{ section.settings.title }}</h2>

    <div class="fbt-items-list">
        {% for block in section.blocks %}
            {% assign product = block.settings.selected_product %}
            {% if product!= blank and product.available %}
                <div class="fbt-item">
                    <!-- Hidden ID for the JavaScript to find later -->
                <input type="checkbox" class="fbt-checkbox" checked 
                 data-variant-id="{{ product.selected_or_first_available_variant.id }}">
          
                <img src="{{ product.featured_image | img_url: '100x100' }}" alt="{{ product.title }}">
                <p>{{ product.title }} - {{ product.price | money }}</p>

                </div>
                {% endif %}
                {% endfor %}
    </div>
    <button type="button" id="add-fbt-to-cart">Add Bundle to Cart</button>
</div>

{% schema %}
{
    "name":"FBT Section",
    "settings": [
        {
            "type": "text",
            "id":"title",
            "label": "Section Title",
            "default":"Frequently Bought Together"
        }
    ],
    "blocks": [
        {
            "type": "product_block",
            "name":"Product",
            "limit": 3,
            "settings": [
                {
                    "type": "product",
                    "id": "selected_product",
                    "label":"Choose a Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FBT Section"
        }
    ]
}

{% endschema %}