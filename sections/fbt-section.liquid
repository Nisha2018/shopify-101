<div class="fbt-container">
    <h2>{{ section.settings.title }}</h2>
</div>

{% schema %}
{
    "name":"FBT Section",
    "settings": [
        {
            "type": "text",
            "id":"title",
            "label": "Section Title",
            "default":"Frequently Bought Together"
        }
    ],
    "blocks": [
        {
            "type": "product_block",
            "name":"Product",
            "limit": 3,
            "settings": [
                {
                    "type": "product",
                    "id": "selected_product",
                    "label":"Choose a Product"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "FBT Section"
        }
    ]
}

{% endschema %}