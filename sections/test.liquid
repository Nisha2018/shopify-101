<h1>{{ shop.name }}</h1>

<div class="product">
    <h2>{{ product.title }}</h2>

    {% if product.featured_image %}
        <img 
            src="{{ product.featured_image }}"
            alt="{{ product.featured_image.alt | escape }}"
            width="500"
            height="500"
            loading="lazy"
        
        >
    {% endif %}
    <p>{{ product.price | money }}</p>
</div>